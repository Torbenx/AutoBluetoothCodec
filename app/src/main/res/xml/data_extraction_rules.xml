<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and transfer rules since API 31.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The event log is diagnostic data of this phone, see EventLog -->
    <cloud-backup>
        <exclude domain="file" path="logs" />
        <!-- Where it's written before the user unlocks the phone after a reboot -->
        <exclude domain="device_file" path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs" />
        <!-- Where it's written before the user unlocks the phone after a reboot -->
        <exclude domain="device_file" path="logs" />
    </device-transfer>
</data-extraction-rules>
