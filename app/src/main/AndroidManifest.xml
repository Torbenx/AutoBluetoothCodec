<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Up to API 30 the A2DP profile calls are guarded by the legacy BLUETOOTH permission -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Since API 33 the system binds CodecCompanionService while an associated device is present -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE"/>

    <!-- Since API 31 a link exempts the app from losing its permission while unused, since API 33 it
         lets CodecCompanionService apply the preferred codec when a device appears, and since API 34
         it's needed to change the codec. Without it only A2dpConnectReceiver applies the preferred codec. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoBluetoothCodec">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:parentActivityName=".AboutActivity" />
        <!-- Shares exported logs, see LogExport -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Only enabled since API 33: on API 31 and 32 the system unbinds it before A2DP connects,
             and forgets at every reboot that the app observes a device -->
        <service
            android:name=".CodecCompanionService"
            android:enabled="@bool/companion_service_enabled"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService"/>
            </intent-filter>
        </service>
        <!-- Enabled on every API level, it also covers A2DP connecting while CodecCompanionService doesn't run -->
        <receiver
            android:name=".A2dpConnectReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>