<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Mobly snippet runs in the app's process and talks to the test host over a local socket -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Only reachable by an explicit broadcast from adb shell, which holds the DUMP permission -->
        <receiver
            android:name=".TestLabelReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
